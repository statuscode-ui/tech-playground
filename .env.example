# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These Firebase web config values are NOT secrets (they identify your project);
# access is controlled by Security Rules and App Check. Never put private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key). Strongly recommended before enabling the AI assistant.
VITE_RECAPTCHA_SITE_KEY=

# AI assistant via Firebase AI Logic (Gemini Developer API). "true" to enable.
VITE_AI_ENABLED=false
# Check the model list in Firebase console > AI Logic before deploying.
VITE_AI_MODEL=gemini-3.5-flash-lite


# Public site URL, used for canonical links (no trailing slash).
VITE_SITE_URL=https://serenity-haven-spa.web.app
